<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Purchase_Definitions" targetNamespace="http://delir.test/purchase">
  <bpmn:collaboration id="Purchase_Collaboration">
    <bpmn:participant id="Company" name="Azienda" processRef="Purchase_Process" />
    <bpmn:participant id="Supplier" name="Fornitore" />
    <bpmn:messageFlow id="Supplier_Message" sourceRef="Supplier" targetRef="Create_Order"><bpmn:documentation>Ordine da confermare</bpmn:documentation></bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="Purchase_Process" isExecutable="false">
    <bpmn:laneSet id="Purchase_Lanes">
      <bpmn:lane id="Technical" name="Ufficio tecnico"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Open_Request</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Purchasing" name="Acquisti"><bpmn:flowNodeRef>Verify</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Director_Sign</bpmn:flowNodeRef><bpmn:flowNodeRef>Create_Order</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Maintenance" name="Manutenzione"><bpmn:flowNodeRef>Urgent_Call</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Materiale mancante"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Open_Request" name="Apri richiesta di acquisto"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Verify" name="Verifica autorizzazione"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Importo oltre 5000 euro?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Director_Sign" name="Raccogli firma direttore"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Create_Order" name="Crea e invia ordine"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Urgent_Call" name="Chiama fornitore urgente"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End" name="Ordine inviato"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataObjectReference id="Request_Document" name="Richiesta di acquisto" />
    <bpmn:association id="Request_Data" sourceRef="Open_Request" targetRef="Request_Document" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Open_Request" />
    <bpmn:sequenceFlow id="F2" sourceRef="Open_Request" targetRef="Verify" />
    <bpmn:sequenceFlow id="F3" sourceRef="Verify" targetRef="Decision"><bpmn:documentation>Autorizzazione verificata</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" name="Sopra soglia" sourceRef="Decision" targetRef="Director_Sign" />
    <bpmn:sequenceFlow id="F5" name="Sotto soglia" sourceRef="Decision" targetRef="Create_Order" />
    <bpmn:sequenceFlow id="F6" sourceRef="Director_Sign" targetRef="Create_Order" />
    <bpmn:sequenceFlow id="F7" sourceRef="Create_Order" targetRef="End" />
    <bpmn:sequenceFlow id="F8" sourceRef="Open_Request" targetRef="Urgent_Call"><bpmn:documentation>Urgenza</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="Urgent_Call" targetRef="End" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="DeliR_Diagram"><bpmndi:BPMNPlane id="DeliR_Plane" bpmnElement="Purchase_Collaboration"><bpmndi:BPMNShape id="Company_di" bpmnElement="Company" isHorizontal="true"><dc:Bounds x="80" y="80" width="1740" height="670" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Maintenance_di" bpmnElement="Maintenance" isHorizontal="true"><dc:Bounds x="110" y="590" width="1710" height="160" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Purchasing_di" bpmnElement="Purchasing" isHorizontal="true"><dc:Bounds x="110" y="408" width="1710" height="182" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Supplier_di" bpmnElement="Supplier" isHorizontal="true"><dc:Bounds x="80" y="830" width="1740" height="100" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Technical_di" bpmnElement="Technical" isHorizontal="true"><dc:Bounds x="110" y="80" width="1710" height="328" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Request_Document_di" bpmnElement="Request_Document"><dc:Bounds x="468" y="288" width="64" height="54" /><bpmndi:BPMNLabel><dc:Bounds x="430" y="350" width="140" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="242" y="146" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="190" y="190" width="140" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Open_Request_di" bpmnElement="Open_Request"><dc:Bounds x="420" y="124" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Urgent_Call_di" bpmnElement="Urgent_Call"><dc:Bounds x="660" y="630" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Verify_di" bpmnElement="Verify"><dc:Bounds x="660" y="459" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision"><dc:Bounds x="955" y="474" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="910" y="532" width="140" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Director_Sign_di" bpmnElement="Director_Sign"><dc:Bounds x="1140" y="459" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Create_Order_di" bpmnElement="Create_Order"><dc:Bounds x="1380" y="459" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1682" y="481" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1630" y="525" width="140" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="278" y="164" /><di:waypoint x="420" y="164" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="580" y="164" /><di:waypoint x="592" y="164" /><di:waypoint x="592" y="499" /><di:waypoint x="660" y="499" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="820" y="499" /><di:waypoint x="955" y="499" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="1005" y="499" /><di:waypoint x="1140" y="499" /><bpmndi:BPMNLabel><dc:Bounds x="1036.5" y="461" width="72" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="1005" y="499" /><di:waypoint x="1017" y="499" /><di:waypoint x="1017" y="447" /><di:waypoint x="1368" y="447" /><di:waypoint x="1368" y="499" /><di:waypoint x="1380" y="499" /><bpmndi:BPMNLabel><dc:Bounds x="975" y="401" width="72" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1300" y="499" /><di:waypoint x="1380" y="499" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1540" y="499" /><di:waypoint x="1682" y="499" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="580" y="164" /><di:waypoint x="592" y="164" /><di:waypoint x="592" y="670" /><di:waypoint x="660" y="670" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="820" y="670" /><di:waypoint x="1626" y="670" /><di:waypoint x="1626" y="517" /><di:waypoint x="1682" y="517" /><di:waypoint x="1682" y="499" /><di:waypoint x="1682" y="499" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Request_Data_di" bpmnElement="Request_Data"><di:waypoint x="580" y="164" /><di:waypoint x="592" y="164" /><di:waypoint x="592" y="216" /><di:waypoint x="456" y="216" /><di:waypoint x="456" y="315" /><di:waypoint x="468" y="315" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Supplier_Message_di" bpmnElement="Supplier_Message"><di:waypoint x="1820" y="880" /><di:waypoint x="1832" y="880" /><di:waypoint x="1832" y="447" /><di:waypoint x="1368" y="447" /><di:waypoint x="1368" y="499" /><di:waypoint x="1380" y="499" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>