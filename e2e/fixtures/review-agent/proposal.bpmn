NShape><bpmndi:BPMNShape id="record_di" bpmnElement="record"><dc:Bounds x="536" y="120" width="160" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="776" y="142" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="begin_di" bpmnElement="begin"><di:waypoint x="216" y="160" /><di:waypoint x="296" y="160" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="finish_di" bpmnElement="finish"><di:waypoint x="696" y="160" /><di:waypoint x="776" y="160" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="handoff_di" bpmnElement="handoff"><di:waypoint x="456" y="160" /><di:waypoint x="536" y="160" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>