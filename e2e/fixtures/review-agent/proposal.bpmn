MNEdge id="finish_di" bpmnElement="finish"><di:waypoint x="868" y="282.0" /><di:waypoint x="1448" y="282.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="handoff_di" bpmnElement="handoff"><di:waypoint x="638" y="282.0" /><di:waypoint x="758" y="282.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>