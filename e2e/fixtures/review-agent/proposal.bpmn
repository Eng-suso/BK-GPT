NShape><bpmndi:BPMNShape id="record_di" bpmnElement="record"><dc:Bounds x="460" y="108" width="144" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="660" y="122" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="begin_di" bpmnElement="begin"><di:waypoint x="204" y="140" /><di:waypoint x="260" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="finish_di" bpmnElement="finish"><di:waypoint x="604" y="140" /><di:waypoint x="660" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="handoff_di" bpmnElement="handoff"><di:waypoint x="404" y="140" /><di:waypoint x="460" y="140" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>