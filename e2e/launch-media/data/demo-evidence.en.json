   "evidence": [
    {
     "source_id": "src-paolo-marchetti",
     "person": "Paolo Marchetti",
     "role": "Maintenance",
     "quote": "If during the round I see that something is missing, or that a component needs replacing before it becomes a problem, I make a note of it."
    },
    {
     "source_id": "src-laura-conti",
     "person": "Laura Conti",
     "role": "Technical Office",
     "quote": "A shift supervisor sees that consumables are running out"
    }
   ]
  },
  {
   "element_id": "Task_Compila",
   "label": "Fill in the purchase request",
   "status": "source",
   "evidence": [
    {
     "source_id": "src-laura-conti",
     "person": "Laura Conti",
     "role": "Technical Office",
     "quote": "The first thing I do is figure out whether I have enough information to move it forward."
    },
    {
     "source_id": "src-laura-conti",
     "person": "Laura Conti",
     "role": "Technical Office",
     "quote": "So the round of phone calls begins."
    }
   ]
  },
  {
   "element_id": "Task_Invia",
