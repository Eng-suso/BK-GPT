    {
     "source_id": "src-laura-conti",
     "person": "Laura Conti",
     "role": "Technical Office",
     "quote": "Then the request comes to me, and it comes in three different ways depending on who sends it."
    },
    {
     "source_id": "src-laura-conti",
     "person": "Laura Conti",
     "role": "Technical Office",
     "quote": "I pass it to Purchasing. I send them an email with what I've managed to put together"
    }
   ]
