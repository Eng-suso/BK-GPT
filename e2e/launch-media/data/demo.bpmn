<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_hero" targetNamespace="https://delir.ai/bpmn">
  <bpmn:collaboration id="Collaboration_hero"><bpmn:participant id="Participant_hero" name="Richiesta d'acquisto" processRef="Process_hero" /></bpmn:collaboration>
  <bpmn:process id="Process_hero" name="Richiesta d'acquisto" isExecutable="false">
    <bpmn:laneSet id="Process_hero_lanes">
      <bpmn:lane id="requester" name="Reparto"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>send_request</bpmn:flowNodeRef><bpmn:flowNodeRef>complete_request</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="purchasing" name="Ufficio Acquisti"><bpmn:flowNodeRef>gw_check_merge</bpmn:flowNodeRef><bpmn:flowNodeRef>check_request</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_complete</bpmn:flowNodeRef><bpmn:flowNodeRef>issue_po</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="manager" name="Responsabile Acquisti"><bpmn:flowNodeRef>approve_spend</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Fabbisogno rilevato"><bpmn:outgoing>f_start</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="send_request" name="Invia richiesta ad Acquisti"><bpmn:incoming>f_start</bpmn:incoming><bpmn:outgoing>f_send</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="complete_request" name="Completa la richiesta"><bpmn:incoming>f_incomplete</bpmn:incoming><bpmn:outgoing>f_back</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_check_merge"><bpmn:incoming>f_back</bpmn:incoming><bpmn:incoming>f_send</bpmn:incoming><bpmn:outgoing>f_merge</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="check_request" name="Verifica la richiesta"><bpmn:incoming>f_merge</bpmn:incoming><bpmn:outgoing>f_check</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_complete" name="Richiesta completa?" default="f_complete"><bpmn:incoming>f_check</bpmn:incoming><bpmn:outgoing>f_complete</bpmn:outgoing><bpmn:outgoing>f_incomplete</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="issue_po" name="Emetti l'ordine al fornitore"><bpmn:incoming>f_approved</bpmn:incoming><bpmn:outgoing>f_end</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end" name="Ordine inviato"><bpmn:incoming>f_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="approve_spend" name="Autorizza la spesa"><bpmn:incoming>f_complete</bpmn:incoming><bpmn:outgoing>f_approved</bpmn:outgoing></bpmn:userTask>
    <bpmn:sequenceFlow id="f_start" sourceRef="start" targetRef="send_request" />
    <bpmn:sequenceFlow id="f_send" sourceRef="send_request" targetRef="gw_check_merge" />
    <bpmn:sequenceFlow id="f_check" sourceRef="check_request" targetRef="gw_complete" />
    <bpmn:sequenceFlow id="f_incomplete" name="No" sourceRef="gw_complete" targetRef="complete_request"><bpmn:conditionExpression xsi:type="bpmn:tExpression">mancano dati nella richiesta</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_back" sourceRef="complete_request" targetRef="gw_check_merge" />
    <bpmn:sequenceFlow id="f_complete" name="Sì" sourceRef="gw_complete" targetRef="approve_spend" />
    <bpmn:sequenceFlow id="f_approved" sourceRef="approve_spend" targetRef="issue_po" />
    <bpmn:sequenceFlow id="f_end" sourceRef="issue_po" targetRef="end" />
  <bpmn:sequenceFlow id="f_merge" sourceRef="gw_check_merge" targetRef="check_request" /></bpmn:process>
  <bpmndi:BPMNDiagram id="DeliR_Diagram"><bpmndi:BPMNPlane id="DeliR_Plane" bpmnElement="Collaboration_hero"><bpmndi:BPMNShape id="Participant_hero_di" bpmnElement="Participant_hero" isHorizontal="true"><dc:Bounds x="80" y="80" width="1614" height="470" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="manager_di" bpmnElement="manager" isHorizontal="true"><dc:Bounds x="110" y="430" width="1584" height="120" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="purchasing_di" bpmnElement="purchasing" isHorizontal="true"><dc:Bounds x="110" y="272" width="1584" height="158" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="requester_di" bpmnElement="requester" isHorizontal="true"><dc:Bounds x="110" y="80" width="1584" height="192" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="230" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="191" y="226" width="114" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="send_request_di" bpmnElement="send_request"><dc:Bounds x="384" y="168" width="144" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw_check_merge_di" bpmnElement="gw_check_merge"><dc:Bounds x="584" y="326" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="check_request_di" bpmnElement="check_request"><dc:Bounds x="690" y="319" width="144" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw_complete_di" bpmnElement="gw_complete"><dc:Bounds x="945" y="326" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="999" y="380" width="114" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="approve_spend_di" bpmnElement="approve_spend"><dc:Bounds x="1106" y="458" width="144" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="complete_request_di" bpmnElement="complete_request"><dc:Bounds x="1106" y="168" width="144" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="issue_po_di" bpmnElement="issue_po"><dc:Bounds x="1306" y="319" width="144" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1568" y="333" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1544" y="377" width="84" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="f_approved_di" bpmnElement="f_approved"><di:waypoint x="1250" y="490" /><di:waypoint x="1262" y="490" /><di:waypoint x="1262" y="351" /><di:waypoint x="1306" y="351" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_check_di" bpmnElement="f_check"><di:waypoint x="834" y="351" /><di:waypoint x="945" y="351" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_complete_di" bpmnElement="f_complete"><di:waypoint x="970" y="376" /><di:waypoint x="970" y="490" /><di:waypoint x="1106" y="490" /><bpmndi:BPMNLabel><dc:Bounds x="978" y="442" width="44" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_end_di" bpmnElement="f_end"><di:waypoint x="1450" y="351" /><di:waypoint x="1568" y="351" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_incomplete_di" bpmnElement="f_incomplete"><di:waypoint x="970" y="326" /><di:waypoint x="970" y="200" /><di:waypoint x="1106" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="978" y="224" width="44" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_merge_di" bpmnElement="f_merge"><di:waypoint x="634" y="351" /><di:waypoint x="690" y="351" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_send_di" bpmnElement="f_send"><di:waypoint x="528" y="200" /><di:waypoint x="540" y="200" /><di:waypoint x="540" y="351" /><di:waypoint x="584" y="351" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_start_di" bpmnElement="f_start"><di:waypoint x="266" y="200" /><di:waypoint x="384" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f_back_di" bpmnElement="f_back"><di:waypoint x="1178" y="168" /><di:waypoint x="1178" y="156" /><di:waypoint x="609" y="156" /><di:waypoint x="609" y="326" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>