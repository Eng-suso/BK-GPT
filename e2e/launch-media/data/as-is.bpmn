      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1"><dc:Bounds x="2707" y="77" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2670" y="119" width="110" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_di" bpmnElement="Flow_start"><di:waypoint x="193" y="95" /><di:waypoint x="263" y="95" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_rileva_urgenza_di" bpmnElement="Flow_rileva_urgenza"><di:waypoint x="387" y="95" /><di:waypoint x="450" y="95" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_urgenza_ordinaria_di" bpmnElement="Flow_urgenza_ordinaria"><di:waypoint x="500" y="95" /><di:waypoint x="563" y="95" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="73" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_urgenza_linea_ferma_di" bpmnElement="Flow_urgenza_linea_ferma"><di:waypoint x="475" y="120" /><di:waypoint x="475" y="205" /><di:waypoint x="563" y="205" /><bpmndi:BPMNLabel><dc:Bounds x="483" y="124" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_chiama_riferimento_di" bpmnElement="Flow_chiama_riferimento"><di:waypoint x="687" y="205" /><di:waypoint x="713" y="205" /></bpmndi:BPMNEdge>
