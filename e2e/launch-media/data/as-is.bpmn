<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_acquisti_indiretti_v3" targetNamespace="https://delir.ai/bpmn">
  <bpmn:collaboration id="Collaboration_acquisti_indiretti">
    <bpmn:participant id="Participant_acquisti_indiretti" name="Gestione acquisto materiali indiretti e servizi" processRef="Process_acquisti_indiretti" />
  </bpmn:collaboration>
  <bpmn:process id="Process_acquisti_indiretti" name="Gestione acquisto materiali indiretti e servizi" isExecutable="false">
    <bpmn:laneSet id="Process_acquisti_indiretti_LaneSet">
      <bpmn:lane id="reparto" name="Reparto">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rileva_fabbisogno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>urgenza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invia_richiesta_ufficio_tecnico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>percorso_urgente_chiama_fornitore_diretto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>percorso_urgente_invia_riferimento_ordine_urgente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verifica_merce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ufficio_tecnico" name="Ufficio Tecnico">
        <bpmn:flowNodeRef>gw_merge_richiesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ricostruisci_richiesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invia_richiesta_acquisti</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acquisti" name="Ufficio Acquisti">
        <bpmn:flowNodeRef>percorso_urgente_regolarizza_ordine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verifica_lavorabilita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_richiesta_completa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>percorso_integrazione_richiedi_integrazione</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_serve_autorizzazione</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>percorso_autorizzazione_richiedi_autorizzazione</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_autorizzazione</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>seleziona_fornitore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>emetti_ordine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="responsabile_acquisti" name="Responsabile Acquisti">
        <bpmn:flowNodeRef>percorso_autorizzazione_autorizza_spesa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="magazzino" name="Magazzino">
        <bpmn:flowNodeRef>ricevi_merce</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="amministrazione" name="Amministrazione">
        <bpmn:flowNodeRef>percorso_urgente_gestione_contabile_fattura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_urgente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Fabbisogno rilevato">
      <bpmn:outgoing>Flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="rileva_fabbisogno" name="Rileva fabbisogno durante il giro impianti">
      <bpmn:incoming>Flow_start</bpmn:incoming>
      <bpmn:outgoing>Flow_rileva_urgenza</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="urgenza" name="Linea ferma?" default="Flow_urgenza_ordinaria">
      <bpmn:incoming>Flow_rileva_urgenza</bpmn:incoming>
      <bpmn:outgoing>Flow_urgenza_ordinaria</bpmn:outgoing>
      <bpmn:outgoing>Flow_urgenza_linea_ferma</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="invia_richiesta_ufficio_tecnico" name="Invia richiesta all'Ufficio Tecnico">
      <bpmn:incoming>Flow_urgenza_ordinaria</bpmn:incoming>
      <bpmn:outgoing>Flow_richiesta_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="percorso_urgente_chiama_fornitore_diretto" name="Chiama fornitore direttamente">
      <bpmn:incoming>Flow_urgenza_linea_ferma</bpmn:incoming>
      <bpmn:outgoing>Flow_chiama_riferimento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="percorso_urgente_invia_riferimento_ordine_urgente" name="Invia riferimento ordine del fornitore">
      <bpmn:incoming>Flow_chiama_riferimento</bpmn:incoming>
      <bpmn:outgoing>Flow_riferimento_regolarizza</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_merge_richiesta">
      <bpmn:incoming>Flow_richiesta_merge</bpmn:incoming>
      <bpmn:incoming>Flow_integrazione_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_ricostruisci</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ricostruisci_richiesta" name="Ricostruisci richiesta e informazioni mancanti">
      <bpmn:incoming>Flow_merge_ricostruisci</bpmn:incoming>
      <bpmn:outgoing>Flow_ricostruisci_invia</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="invia_richiesta_acquisti" name="Invia richiesta ad Acquisti">
      <bpmn:incoming>Flow_ricostruisci_invia</bpmn:incoming>
      <bpmn:outgoing>Flow_invia_verifica</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="percorso_urgente_regolarizza_ordine" name="Regolarizza ordine a posteriori">
      <bpmn:incoming>Flow_riferimento_regolarizza</bpmn:incoming>
      <bpmn:outgoing>Flow_regolarizza_contabile</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="percorso_urgente_gestione_contabile_fattura" name="Gestione contabile della fattura">
      <bpmn:incoming>Flow_regolarizza_contabile</bpmn:incoming>
      <bpmn:outgoing>Flow_contabile_fine</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_urgente" name="Ordine urgente registrato">
      <bpmn:incoming>Flow_contabile_fine</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="verifica_lavorabilita" name="Verifica lavorabilità della richiesta">
      <bpmn:incoming>Flow_invia_verifica</bpmn:incoming>
      <bpmn:outgoing>Flow_verifica_completa</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_richiesta_completa" name="Richiesta completa?" default="Flow_completa_si">
      <bpmn:incoming>Flow_verifica_completa</bpmn:incoming>
      <bpmn:outgoing>Flow_completa_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_completa_si</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="percorso_integrazione_richiedi_integrazione" name="Richiedi integrazione della richiesta">
      <bpmn:incoming>Flow_completa_no</bpmn:incoming>
      <bpmn:outgoing>Flow_integrazione_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_serve_autorizzazione" name="Serve autorizzazione?" default="Flow_autorizzazione_no">
      <bpmn:incoming>Flow_completa_si</bpmn:incoming>
      <bpmn:outgoing>Flow_autorizzazione_si</bpmn:outgoing>
      <bpmn:outgoing>Flow_autorizzazione_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="percorso_autorizzazione_richiedi_autorizzazione" name="Richiedi autorizzazione al responsabile">
      <bpmn:incoming>Flow_autorizzazione_si</bpmn:incoming>
      <bpmn:outgoing>Flow_richiedi_autorizza</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="percorso_autorizzazione_autorizza_spesa" name="Autorizza spesa">
      <bpmn:incoming>Flow_richiedi_autorizza</bpmn:incoming>
      <bpmn:outgoing>Flow_autorizza_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_merge_autorizzazione">
      <bpmn:incoming>Flow_autorizza_merge</bpmn:incoming>
      <bpmn:incoming>Flow_autorizzazione_no</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_seleziona</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="seleziona_fornitore" name="Seleziona fornitore o richiedi quotazioni">
      <bpmn:incoming>Flow_merge_seleziona</bpmn:incoming>
      <bpmn:outgoing>Flow_seleziona_emetti</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="emetti_ordine" name="Emetti ordine al fornitore">
      <bpmn:incoming>Flow_seleziona_emetti</bpmn:incoming>
      <bpmn:outgoing>Flow_emetti_ricevi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ricevi_merce" name="Ricevi merce in magazzino">
      <bpmn:incoming>Flow_emetti_ricevi</bpmn:incoming>
      <bpmn:outgoing>Flow_ricevi_verifica</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="verifica_merce" name="Verifica merce ricevuta">
      <bpmn:incoming>Flow_ricevi_verifica</bpmn:incoming>
      <bpmn:outgoing>Flow_verifica_fine</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Merce verificata">
      <bpmn:incoming>Flow_verifica_fine</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="StartEvent_1" targetRef="rileva_fabbisogno" />
    <bpmn:sequenceFlow id="Flow_rileva_urgenza" sourceRef="rileva_fabbisogno" targetRef="urgenza" />
    <bpmn:sequenceFlow id="Flow_urgenza_ordinaria" name="No" sourceRef="urgenza" targetRef="invia_richiesta_ufficio_tecnico" />
    <bpmn:sequenceFlow id="Flow_urgenza_linea_ferma" name="Sì" sourceRef="urgenza" targetRef="percorso_urgente_chiama_fornitore_diretto" />
    <bpmn:sequenceFlow id="Flow_chiama_riferimento" sourceRef="percorso_urgente_chiama_fornitore_diretto" targetRef="percorso_urgente_invia_riferimento_ordine_urgente" />
    <bpmn:sequenceFlow id="Flow_riferimento_regolarizza" sourceRef="percorso_urgente_invia_riferimento_ordine_urgente" targetRef="percorso_urgente_regolarizza_ordine" />
    <bpmn:sequenceFlow id="Flow_regolarizza_contabile" sourceRef="percorso_urgente_regolarizza_ordine" targetRef="percorso_urgente_gestione_contabile_fattura" />
    <bpmn:sequenceFlow id="Flow_contabile_fine" sourceRef="percorso_urgente_gestione_contabile_fattura" targetRef="EndEvent_urgente" />
    <bpmn:sequenceFlow id="Flow_richiesta_merge" sourceRef="invia_richiesta_ufficio_tecnico" targetRef="gw_merge_richiesta" />
    <bpmn:sequenceFlow id="Flow_merge_ricostruisci" sourceRef="gw_merge_richiesta" targetRef="ricostruisci_richiesta" />
    <bpmn:sequenceFlow id="Flow_ricostruisci_invia" sourceRef="ricostruisci_richiesta" targetRef="invia_richiesta_acquisti" />
    <bpmn:sequenceFlow id="Flow_invia_verifica" sourceRef="invia_richiesta_acquisti" targetRef="verifica_lavorabilita" />
    <bpmn:sequenceFlow id="Flow_verifica_completa" sourceRef="verifica_lavorabilita" targetRef="gw_richiesta_completa" />
    <bpmn:sequenceFlow id="Flow_completa_no" name="No" sourceRef="gw_richiesta_completa" targetRef="percorso_integrazione_richiedi_integrazione" />
    <bpmn:sequenceFlow id="Flow_integrazione_merge" sourceRef="percorso_integrazione_richiedi_integrazione" targetRef="gw_merge_richiesta" />
    <bpmn:sequenceFlow id="Flow_completa_si" name="Sì" sourceRef="gw_richiesta_completa" targetRef="gw_serve_autorizzazione" />
    <bpmn:sequenceFlow id="Flow_autorizzazione_si" name="Sì" sourceRef="gw_serve_autorizzazione" targetRef="percorso_autorizzazione_richiedi_autorizzazione" />
    <bpmn:sequenceFlow id="Flow_richiedi_autorizza" sourceRef="percorso_autorizzazione_richiedi_autorizzazione" targetRef="percorso_autorizzazione_autorizza_spesa" />
    <bpmn:sequenceFlow id="Flow_autorizza_merge" sourceRef="percorso_autorizzazione_autorizza_spesa" targetRef="gw_merge_autorizzazione" />
    <bpmn:sequenceFlow id="Flow_autorizzazione_no" name="No" sourceRef="gw_serve_autorizzazione" targetRef="gw_merge_autorizzazione" />
    <bpmn:sequenceFlow id="Flow_merge_seleziona" sourceRef="gw_merge_autorizzazione" targetRef="seleziona_fornitore" />
    <bpmn:sequenceFlow id="Flow_seleziona_emetti" sourceRef="seleziona_fornitore" targetRef="emetti_ordine" />
    <bpmn:sequenceFlow id="Flow_emetti_ricevi" sourceRef="emetti_ordine" targetRef="ricevi_merce" />
    <bpmn:sequenceFlow id="Flow_ricevi_verifica" sourceRef="ricevi_merce" targetRef="verifica_merce" />
    <bpmn:sequenceFlow id="Flow_verifica_fine" sourceRef="verifica_merce" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_acquisti_indiretti">
    <bpmndi:BPMNPlane id="Plane_acquisti_indiretti" bpmnElement="Collaboration_acquisti_indiretti">
      <bpmndi:BPMNShape id="Participant_acquisti_indiretti_di" bpmnElement="Participant_acquisti_indiretti" isHorizontal="true"><dc:Bounds x="40" y="40" width="2780" height="990" /></bpmndi:BPMNShape>
