{
  "disclaimer": "Azienda e persone fittizie · caso dimostrativo",
  "hold": 2.6,
  "hook": [
    {
      "line": "Tre interviste.",
      "sub": "Tre versioni diverse dello stesso processo."
    },
    {
      "line": "Giorni a ricostruirlo dagli appunti."
    },
    {
      "line": "Poi il cliente chiede:",
      "quote": "Questo chi l'ha detto?"
    },
    {
      "line": "E subito dopo:",
      "quote": "Quanto ci fa risparmiare?",
      "sub": "E tu rispondi a sensazione."
    }
  ],
  "stages": [
    "Interviste",
    "As-Is",
    "Simulazione",
    "Event log",
    "To-Be",
    "Process owner"
  ],
  "scenes": [
    {
      "id": "01-gancio",
      "card": "hook"
    },
    {
      "id": "01b-promessa",
      "card": "promise",
      "title": "Con DeliR, dal cliente arrivi con:",
      "points": [
        "un As-Is con la fonte di ogni passaggio,",
        "il collo di bottiglia misurato, non intuito,",
        "un To-Be con il risparmio già simulato."
      ]
    },
    {
      "id": "02-interviste-a-delir",
      "caption": "Carichi le interviste. DeliR estrae chi fa cosa.",
      "landing": "chat-discovery",
      "stage": 0
    },
    {
      "id": "03-fonti",
      "caption": "«Chi l'ha detto?» Ecco la frase esatta.",
      "landing": "fonti-e-affermazioni",
      "stage": 0
    },
    {
      "id": "04-passaggio-nascosto",
      "caption": "Le versioni che non tornano escono prima del workshop.",
      "landing": "passaggio-nascosto",
      "stage": 0
    },
    {
      "id": "05-lacuna",
      "caption": "Quello che nessuno ha detto diventa una domanda per il cliente.",
      "landing": "lacuna-aperta",
      "stage": 0
    },
    {
      "id": "06-as-is",
      "caption": "La bozza As-Is arriva già collegata alle fonti.",
      "landing": "evidenze-sul-processo",
      "stage": 1
    },
    {
      "id": "07-review-as-is",
      "caption": "Rivedi ogni attività con DeliR, prima di mostrarla.",
      "landing": "review-as-is",
      "stage": 1
    },
    {
      "id": "08-as-is-corretto",
      "caption": "Ogni correzione resta tracciata, versione per versione.",
      "landing": "as-is-corretto",
      "stage": 1
    },
    {
      "id": "09-simula-as-is",
      "caption": "Simuli il processo di oggi, prima di cambiarlo.",
      "landing": "simulazione-as-is",
      "stage": 2
    },
    {
      "id": "10-heatmap",
      "caption": "Il collo di bottiglia, misurato: quasi 3 giorni di attesa.",
      "landing": "heatmap-collo-di-bottiglia",
      "stage": 2
    },
    {
      "id": "11-event-log",
      "caption": "Controlli la simulazione sul log del cliente: scarto 2%.",
      "landing": "event-log",
      "stage": 3
    },
    {
      "id": "12-review-to-be",
      "caption": "Chiedi a DeliR dove intervenire. Risponde con le fonti.",
      "landing": "review-to-be",
      "stage": 4
    },
    {
      "id": "13-ipotesi-to-be",
      "caption": "Il To-Be parte da quello che chiede chi lavora nel processo.",
      "landing": "ipotesi-to-be",
      "stage": 4
    },
    {
      "id": "14-simula-to-be",
      "caption": "Stesse richieste. Processo nuovo.",
      "landing": "simulazione-to-be",
      "stage": 4
    },
    {
      "id": "15-decidi",
      "caption": "«Quanto ci fa risparmiare?» −75% di tempo, −29% di costo. Simulato.",
      "landing": "confronto",
      "stage": 4
    },
    {
      "id": "16-process-owner",
      "caption": "Il To-Be va al process owner in BPMN, pronto da validare.",
      "landing": "process-owner",
      "stage": 5
    },
    {
      "id": "17-memoria",
      "caption": "Fonti, versioni e simulazioni restano nel progetto.",
      "captions": [
        {
          "text": "Il prossimo cliente non parte da zero.",
          "mark": "portfolio",
          "duration": 3
        }
      ],
      "landing": "memoria",
      "stage": 6
    },
    {
      "id": "17b-risultato",
      "card": "result",
      "title": "Il risultato per Vetrano Industriale",
      "tiles": [
        {
          "value": "38",
          "label": "affermazioni, ognuna con la sua citazione"
        },
        {
          "value": "2g 22h",
          "label": "di attesa sull'autorizzazione, misurata"
        },
        {
          "value": "−75%",
          "label": "tempo di attraversamento nel To‑Be"
        },
        {
          "value": "−29%",
          "label": "costo per pratica nel To‑Be"
        }
      ],
      "note": "Valori simulati · modello As-Is verificato sul log del cliente (scarto 2%)"
    },
    {
      "id": "18-chiusura",
      "card": "close",
      "title": "Dalle interviste alla decisione del cliente. Con i numeri."
    },
