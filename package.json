{
  "name": "delir-mvp",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:backend": "uv run uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 3030",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "screenshots:pitch": "playwright test e2e/pitch-screenshots.spec.ts --project=chromium --workers=1",
    "media:launch": "playwright test -c playwright.launch.config.ts && node scripts/launch_media_render.mjs && python3 scripts/launch_media_edit.py",
    "media:launch:render": "node scripts/launch_media_render.mjs && python3 scripts/launch_media_edit.py",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:lighthouse": "playwright test e2e/performance-lighthouse.spec.ts",
    "test:report": "playwright show-report",
    "test:backend": "uv run pytest tests/ -v",
    "mem0:check": "uv run python -m scripts.queue_admin list",
    "mem0:purge-test": "uv run python -m scripts.queue_admin purge-pending --queue mem0_projection_log --apply",
    "agent:worktree": "uv run python scripts/new_agent_worktree.py",
    "test:unit": "npm --prefix frontend run test:ci",
    "lint": "npm --prefix frontend run lint",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e",
    "seed:e2e": "uv run python -m scripts.seed_e2e",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "check:bundle": "npm run build && node scripts/check_bundle_budget.mjs",
    "check:bundle:update": "npm run build && node scripts/check_bundle_budget.mjs --update"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "playwright-lighthouse": "^4.0.0"
  }
}
