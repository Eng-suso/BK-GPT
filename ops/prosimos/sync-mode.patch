diff --git a/Dockerfile.api b/Dockerfile.api
index 4e4e709..3087857 100644
--- a/Dockerfile.api
+++ b/Dockerfile.api
@@ -2,7 +2,7 @@
 # `python-base` stage
 #  contains all shared environment variables
 #
-FROM python:3.9-slim-buster as python-base
+FROM python:3.9-slim-bookworm as python-base
 
 ENV \
     POETRY_VERSION=1.4.2 \
@@ -44,5 +44,19 @@ RUN poetry install --only main
 
 ENV FLASK_DEBUG=0
 
+# Simulations run in-process (sync mode) and are CPU-bound + single-threaded.
+# One gunicorn worker == one concurrent simulation. 6 covers ~3-5 consultants
+# running at once plus headroom for /health and list endpoints.
+ENV GUNICORN_WORKERS=6 \
+    GUNICORN_TIMEOUT=1800
+
 EXPOSE 5000
-CMD ["gunicorn", "--workers=3", "--threads=3", "-b", ":5000", "app:app", "--timeout 1000"]
+CMD gunicorn \
+    --workers=${GUNICORN_WORKERS} \
+    --timeout=${GUNICORN_TIMEOUT} \
+    --graceful-timeout=30 \
+    --access-logfile=- \
+    --capture-output \
+    --enable-stdio-inheritance \
+    -b :5000 \
+    app:app
