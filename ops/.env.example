# Copia in ops/postgres/.env e cambia tutte le password prima di qualunque uso reale.
# Questo file NON e' segreto; .env si', ed e' gia' git-ignored.

POSTGRES_PORT=5432

# Superuser del cluster — usato solo dall'entrypoint e dal bootstrap dei ruoli.
POSTGRES_SUPER_PASSWORD=change-me-super

# Ruoli applicativi creati dal bootstrap.
DELIR_MIGRATOR_PASSWORD=change-me-migrator
DELIR_APP_PASSWORD=change-me-app
DELIR_WORKER_PASSWORD=change-me-worker
DELIR_MEM0_PASSWORD=change-me-mem0
DELIR_WORKSPACE_PASSWORD=change-me-workspace

# Neo4j (anche il compose dei dati la richiede).
NEO4J_PASSWORD=change-me-neo4j

# --- Produzione (docker-compose.prod.yml) ------------------------------------
# Le password qui sopra finiscono dentro gli URL dei database: solo lettere e
# cifre, niente @ : / # ?.
#
# Il token che il browser manda a ogni richiesta (lungo, casuale):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DELIR_API_TOKEN=change-me-api-token
DELIR_ADMIN_TOKEN=
# L'unico spazio di lavoro ammesso in questo deploy (un consulente).
DELIR_TENANT_ID=pilot
# L'indirizzo da cui il consulente apre l'app, senza / finale.
DELIR_PUBLIC_ORIGIN=https://app.example.com
# Chiave del provider dedicata alla produzione, con tetto di spesa.
OPENAI_API_KEY=change-me-openai
