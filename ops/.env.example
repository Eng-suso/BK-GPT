# Copia in ops/.env e cambia tutte le password prima di qualunque uso reale.
# Questo file NON e' segreto; .env si', ed e' gia' git-ignored.

POSTGRES_PORT=5432

# Superuser del cluster — usato solo dall'entrypoint e dal bootstrap dei ruoli.
POSTGRES_SUPER_PASSWORD=change-me-super

# Ruoli applicativi creati dal bootstrap.
DELIR_MIGRATOR_PASSWORD=change-me-migrator
DELIR_APP_PASSWORD=change-me-app
DELIR_WORKER_PASSWORD=change-me-worker
DELIR_MEM0_PASSWORD=change-me-mem0
DELIR_WORKSPACE_PASSWORD=change-me-workspace

# Neo4j (anche il compose dei dati la richiede).
NEO4J_PASSWORD=change-me-neo4j

# Token condiviso fra app e runner Prosimos (vuoto = solo isolamento di rete).
PROSIMOS_API_TOKEN=

# --- Produzione (docker-compose.prod.yml) ------------------------------------
# Le password qui sopra finiscono dentro gli URL dei database: solo lettere e
# cifre, niente @ : / # ?.
#
# Il token che il browser manda a ogni richiesta (lungo, casuale):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DELIR_API_TOKEN=change-me-api-token
# La chiave per le cancellazioni (clienti, progetti, processi, workspace): si
# genera allo stesso modo e deve essere diversa da DELIR_API_TOKEN. Va
# nell'header X-DeliR-Admin-Token; la UI non la chiede: le cancellazioni dalla
# UI arrivano con i ruoli per persona (Track B2). L'app non parte se manca, e'
# piu' corta di 32 caratteri o coincide col token API.
DELIR_ADMIN_TOKEN=change-me-admin-token
# Login per persona con Supabase Auth (Track B). Lasciare `token` finche' il
# progetto Supabase dell'ambiente non esiste. Con `supabase`: URL del progetto
# (https), la sua chiave *publishable* (mai la secret: l'app non parte) e
# l'host del progetto in DELIR_EGRESS_ALLOWED_HOSTS.
DELIR_AUTH_PROVIDER=token
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibilita' col pilota a tenant singolo. Per un deploy multi-tenant usare
# DELIR_DEFAULT_TENANT_ID e DELIR_ALLOWED_TENANT_IDS (lista separata da virgole).
DELIR_TENANT_ID=pilot
# L'indirizzo da cui il consulente apre l'app, senza / finale.
DELIR_PUBLIC_ORIGIN=https://app.example.com
# Chiave del provider dedicata alla produzione, con tetto di spesa.
OPENAI_API_KEY=change-me-openai
