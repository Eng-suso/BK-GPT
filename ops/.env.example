# Copia in ops/postgres/.env e cambia tutte le password prima di qualunque uso reale.
# Questo file NON e' segreto; .env si', ed e' gia' git-ignored.

POSTGRES_PORT=5432

# Superuser del cluster — usato solo dall'entrypoint e dal bootstrap dei ruoli.
POSTGRES_SUPER_PASSWORD=change-me-super

# Ruoli applicativi creati dal bootstrap.
DELIR_MIGRATOR_PASSWORD=change-me-migrator
DELIR_APP_PASSWORD=change-me-app
DELIR_WORKER_PASSWORD=change-me-worker
DELIR_MEM0_PASSWORD=change-me-mem0
