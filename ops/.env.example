# Copia in ops/.env e cambia tutte le password prima di qualunque uso reale.
# Questo file NON e' segreto; .env si', ed e' gia' git-ignored.

POSTGRES_PORT=5432

# Superuser del cluster — usato solo dall'entrypoint e dal bootstrap dei ruoli.
POSTGRES_SUPER_PASSWORD=change-me-super

# Ruoli applicativi creati dal bootstrap.
DELIR_MIGRATOR_PASSWORD=change-me-migrator
DELIR_APP_PASSWORD=change-me-app
DELIR_WORKER_PASSWORD=change-me-worker
DELIR_MEM0_PASSWORD=change-me-mem0
DELIR_WORKSPACE_PASSWORD=change-me-workspace

# Neo4j (anche il compose dei dati la richiede).
NEO4J_PASSWORD=change-me-neo4j

# Token condiviso fra app e runner Prosimos (vuoto = solo isolamento di rete).
PROSIMOS_API_TOKEN=

# --- Produzione (docker-compose.prod.yml) ------------------------------------
# Le password qui sopra finiscono dentro gli URL dei database: solo lettere e
# cifre, niente @ : / # ?.
#
# Il token che il browser manda a ogni richiesta (lungo, casuale):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DELIR_API_TOKEN=change-me-api-token
# La chiave per le cancellazioni (clienti, progetti, processi, workspace): si
# genera allo stesso modo e deve essere diversa da DELIR_API_TOKEN. Va
# nell'header X-DeliR-Admin-Token; la UI non la chiede. Con gli account
# personali ognuno cancella le sue cose da solo: la chiave serve a chi gestisce
# la piattaforma (i limiti di spesa). L'app non parte se manca, e' piu' corta
# di 32 caratteri o coincide col token API.
DELIR_ADMIN_TOKEN=change-me-admin-token
# Login per persona con Supabase Auth: in produzione ogni persona ha il suo
# account, cioe' il suo spazio di lavoro, la sua memoria e il suo limite di
# spesa. Servono l'URL del progetto (https), la sua chiave *publishable* (mai
# la secret: l'app non parte) e l'host del progetto in
# DELIR_EGRESS_ALLOWED_HOSTS. `token` (il token condiviso) solo per uno stack
# di prova senza persone.
DELIR_AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chi puo' entrare: email esatte o interi domini, separati da virgola
# (es. anna@studio.it,@partner.it). Le registrazioni in Supabase restano chiuse;
# questa e' la seconda porta, nel backend. Vuota = l'app non parte.
DELIR_ALLOWED_EMAILS=
# Il limite di spesa di ogni persona (docs/usage-limits/CONTATORE.md), in
# dollari stimati dal listino. Il limite di una persona si cambia con
# PUT /v1/usage/plans/<id dell'account> e X-DeliR-Admin-Token.
USAGE_LIMITS_ENABLED=true
# Il listino dei modelli usati, obbligatorio con i limiti accesi, es.
# {"gpt-5.6-luna": {"input": 0.20, "output": 1.20, "cached_input": 0.02}}
LLM_PRICES_JSON=
USAGE_SESSION_HOURS=5
USAGE_SESSION_BUDGET_USD=1.5
USAGE_WEEK_BUDGET_USD=6
USAGE_TRIAL_BUDGET_USD=20
USAGE_TRIAL_DAYS=14
# Compatibilita' col pilota a tenant singolo. Per un deploy multi-tenant usare
# DELIR_DEFAULT_TENANT_ID e DELIR_ALLOWED_TENANT_IDS (lista separata da virgole).
DELIR_TENANT_ID=pilot
# L'indirizzo da cui il consulente apre l'app, senza / finale.
DELIR_PUBLIC_ORIGIN=https://app.example.com
# Chiave del provider dedicata alla produzione, con tetto di spesa.
OPENAI_API_KEY=change-me-openai
